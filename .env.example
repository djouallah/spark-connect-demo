# Copy to .env (gitignored) and fill in. Read by sf.py.
# Account identifier <orgname>-<account_name>, not a URL.
SNOWFLAKE_ACCOUNT=
# Service user the PAT belongs to (a password + MFA user can't submit programmatically).
SNOWFLAKE_USER=
# Programmatic access token; passed as the connector's password.
SNOWFLAKE_PAT=
# An ordinary role, not ACCOUNTADMIN.
SNOWFLAKE_ROLE=
# An existing warehouse.
SNOWFLAKE_WAREHOUSE=

# LakeSail (platforms/lakesail/run.py): <workspace id>/<lakehouse id> of a schema-enabled lakehouse. Auth is `az login`.
ONELAKE_WAREHOUSE=

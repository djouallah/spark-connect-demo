   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sail and Snowflake: real Spark Connect (gRPC), but the server runs on the laptop.\nFabric: no Spark Connect endpoint; Livy runs the cell code on a remote Spark driver,\nso laptop paths aren't visible there. The Summary and close cells (# laptop) stay local.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "originalText": "Sail and Snowflake: real Spark Connect (gRPC), but the server runs on the laptop.\nFabric: no Spark Connect endpoint; Livy runs the cell code on a remote Spark driver,\nso laptop paths aren't visible there. The Summary and close cells (# laptop) stay local.",
   "autoResize": true,
   "lineHeight": 1.25
  }
